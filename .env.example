APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# AI Features (OpenAI-compatible API)
AI_ENABLED=true
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1024
AI_TIMEOUT=60

# PayStation (Bangladesh) payment gateway
PAYSTATION_ENABLED=false
PAYSTATION_MODE=sandbox
PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=
PAYSTATION_CURRENCY=BDT
PAYSTATION_PAY_WITH_CHARGE=0
# SMS alert after online payment (driver: bdbulksms | bulksmsbd | custom | log)
SMS_ENABLED=false
SMS_DRIVER=log
SMS_ADMIN_NUMBERS=
BDBULKSMS_TOKEN=
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
SMS_CUSTOM_URL=
# Subscription reminder popup
SUBSCRIPTION_REMINDER_DAYS=4
SUBSCRIPTION_REMINDER_INTERVAL_HOURS=12
SUBSCRIPTION_REMINDER_LAST_DAY_INTERVAL_HOURS=1
SUBSCRIPTION_REMINDER_CLOSE_DELAY=5
